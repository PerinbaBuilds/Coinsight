# Copy this file to `.env`, fill in your own Supabase project values, then run:
#
#   flutter run -d chrome --dart-define-from-file=.env
#
# (or `flutter build web --dart-define-from-file=.env ...` for a release build)
#
# If you skip this, the app falls back to the project's public demo backend.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase ANON (public) key — protected by Row Level Security, safe in a
# client bundle. Do NOT use the service_role key here.
SUPABASE_ANON_KEY=your-anon-public-key

# NOTE: the AI Advisor's Groq API key is NOT configured here. It lives
# server-side as a Supabase Edge Function secret (GROQ_API_KEY) so it never
# ships in the client. See the README's "AI Advisor" note.
